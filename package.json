{
  "name": "freepower",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "FreePower — 独立实现的指纹浏览器（多环境隔离 + 代理 + 指纹一致 + 本地 API + 桌面壳）",
  "author": {
    "name": "FreePower"
  },
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/main.js",
    "dev": "node --no-warnings --watch src/main.js",
    "desktop": "node tools/run-desktop.mjs",
    "desktop:selftest": "node tools/run-desktop.mjs --selftest",
    "dist:win": "electron-builder --win --x64",
    "smoke": "node --no-warnings test/smoke.mjs && node --no-warnings test/proxy-chain.test.mjs && node --no-warnings test/workers.test.mjs",
    "test:unit": "node --no-warnings test/unit.test.mjs",
    "test:api": "node --no-warnings test/api.test.mjs",
    "test:ui": "node --no-warnings test/ui.test.mjs",
    "test:desktop": "node --no-warnings test/desktop.test.mjs",
    "test:profile": "node --no-warnings packages/profile/test/schema.test.mjs",
    "test": "node --no-warnings packages/profile/test/schema.test.mjs && node --no-warnings test/net-rules.test.mjs && node --no-warnings test/chain-rules.test.mjs && node --no-warnings test/recycle.test.mjs && node --no-warnings test/unit.test.mjs && node --no-warnings test/api.test.mjs && node --no-warnings test/ui.test.mjs && node --no-warnings test/desktop.test.mjs",
    "gen": "node tools/gen-schema.mjs",
    "test:workers": "node --no-warnings test/workers.test.mjs",
    "test:all": "npm run test && npm run test:workers",
    "test:restart": "node --no-warnings test/restart.test.mjs",
    "test:proxy-health": "node --no-warnings test/proxy-health.test.mjs",
    "test:media-devices": "node --no-warnings test/media-devices.test.mjs",
    "test:media-label": "node --no-warnings test/media-label.test.mjs",
    "test:cdp-page": "node --no-warnings test/cdp-target.test.mjs",
    "test:speech": "node --no-warnings test/speech.test.mjs",
    "test:media-speech": "node --no-warnings test/media-devices.test.mjs && node --no-warnings test/speech.test.mjs",
    "test:cmdline": "node --no-warnings test/cmdline-leak.test.mjs",
    "test:fileio": "node --no-warnings test/fileio.test.mjs",
    "test:native-tostring": "node --no-warnings test/native-tostring.test.mjs",
    "test:nav-race": "node --no-warnings test/nav-race.test.mjs",
    "test:nav-type": "node --no-warnings test/nav-type.test.mjs",
    "test:net-rules": "node --no-warnings test/net-rules.test.mjs",
    "test:recycle": "node --no-warnings test/recycle.test.mjs",
    "test:switches": "node --no-warnings test/switches.test.mjs",
    "test:chain-rules": "node --no-warnings test/chain-rules.test.mjs",
    "test:proxy-chain": "node --no-warnings test/proxy-chain.test.mjs",
    "test:p9c-judge": "node --no-warnings tools/p9c-judge.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  }
}
