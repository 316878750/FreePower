{
  "name": "freepower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FreePower — 独立实现的指纹浏览器（多环境隔离 + 代理 + 指纹一致 + 本地 API）",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/main.js",
    "dev": "node --no-warnings --watch src/main.js",
    "smoke": "node --no-warnings test/smoke.mjs",
    "test:unit": "node --no-warnings test/unit.test.mjs",
    "test:profile": "node --no-warnings packages/profile/test/schema.test.mjs",
    "test": "node --no-warnings packages/profile/test/schema.test.mjs && node --no-warnings test/unit.test.mjs",
    "gen": "node tools/gen-schema.mjs"
  }
}
